// Modelo de datos de Vaquita.
//
// Convención de dinero: TODOS los importes se guardan como enteros en la
// unidad mínima de la moneda (centavos) usando BigInt. Nunca floats.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------- configuración

/// Una sola fila, con id fijo "app". Guarda lo que se configura desde
/// /admin y no tiene sentido pedir por variable de entorno.
model AppSettings {
  id        String   @id @default("app")
  /// Zona IANA con la que se formatean todas las fechas.
  timezone  String   @default("America/Argentina/Buenos_Aires")
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- usuarios

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// Emoji que identifica a la persona. Si está vacío se deriva del nombre.
  emoji        String?
  /// Tinte del círculo del avatar. Se asigna solo, no se elige.
  color        String   @default("#6366f1")
  /// Dónde transferirle: alias, CBU o link de Mercado Pago.
  /// Se muestra sólo a quien le debe plata a esta persona.
  payAlias     String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions           Session[]
  memberships        GroupMember[]
  createdGroups      Group[]        @relation("GroupCreator")
  paidExpenses       ExpensePayer[]
  expenseShares      ExpenseShare[]
  createdExpenses    Expense[]      @relation("ExpenseCreator")
  settlementsSent    Settlement[]   @relation("SettlementFrom")
  settlementsGot     Settlement[]   @relation("SettlementTo")
  createdSettlements Settlement[]   @relation("SettlementCreator")
  comments           Comment[]
  activities         Activity[]
  invitesCreated     Invitation[]   @relation("InviteCreator")
  invitesUsed        Invitation[]   @relation("InviteUser")

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Link de invitación. Sin `groupId` sirve sólo para crear cuenta;
/// con `groupId` además suma a quien lo usa a ese grupo.
model Invitation {
  id          String    @id @default(cuid())
  code        String    @unique
  label       String?
  groupId     String?
  createdById String
  expiresAt   DateTime
  /// Cuántas veces se puede usar. null = las que sea, hasta que venza.
  /// Un link para mandar a un grupo de WhatsApp va con null.
  maxUses     Int?      @default(1)
  useCount    Int       @default(0)
  /// La primera vez que se usó y quién, a título informativo.
  usedAt      DateTime?
  usedById    String?
  createdAt   DateTime  @default(now())

  group     Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User   @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User?  @relation("InviteUser", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([groupId])
}

/// Token de un solo uso para restablecer la contraseña.
/// Lo genera un admin y se comparte a mano (no hay SMTP).
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ------------------------------------------------------------------ grupos

enum GroupRole {
  OWNER
  MEMBER
}

model Group {
  id            String    @id @default(cuid())
  name          String
  emoji         String    @default("👥")
  currency      String    @default("ARS")
  simplifyDebts Boolean   @default(true)
  createdById   String
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy   User          @relation("GroupCreator", fields: [createdById], references: [id])
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  invitations Invitation[]
  activities  Activity[]
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// ------------------------------------------------------------------ gastos

enum SplitType {
  EQUAL
  EXACT
  PERCENT
  SHARES
}

model Expense {
  id          String    @id @default(cuid())
  groupId     String
  description String
  amountCents BigInt
  currency    String
  date        DateTime
  category    String    @default("otros")
  notes       String?
  splitType   SplitType @default(EQUAL)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User           @relation("ExpenseCreator", fields: [createdById], references: [id])
  payers    ExpensePayer[]
  shares    ExpenseShare[]
  comments  Comment[]
  activities Activity[]

  @@index([groupId, date])
  @@index([groupId, deletedAt])
}

/// Quién puso la plata. Soporta varios pagadores en un mismo gasto.
model ExpensePayer {
  id          String @id @default(cuid())
  expenseId   String
  userId      String
  amountCents BigInt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
}

/// Cuánto le toca a cada uno. `weight` guarda el input original
/// (porcentaje en centésimas, o cantidad de partes) para poder editar.
model ExpenseShare {
  id          String @id @default(cuid())
  expenseId   String
  userId      String
  amountCents BigInt
  weight      Int?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
}

// -------------------------------------------------------------------- pagos

model Settlement {
  id          String    @id @default(cuid())
  groupId     String
  fromUserId  String
  toUserId    String
  amountCents BigInt
  currency    String
  date        DateTime
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from      User  @relation("SettlementFrom", fields: [fromUserId], references: [id])
  to        User  @relation("SettlementTo", fields: [toUserId], references: [id])
  createdBy User  @relation("SettlementCreator", fields: [createdById], references: [id])

  activities Activity[]

  @@index([groupId, deletedAt])
}

// --------------------------------------------------------- social / historial

model Comment {
  id        String    @id @default(cuid())
  expenseId String
  userId    String
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

enum ActivityType {
  GROUP_CREATED
  MEMBER_JOINED
  MEMBER_LEFT
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  EXPENSES_RESPLIT
  SETTLEMENT_CREATED
  SETTLEMENT_DELETED
  COMMENT_ADDED
}

model Activity {
  id           String       @id @default(cuid())
  type         ActivityType
  groupId      String?
  actorId      String
  expenseId    String?
  settlementId String?
  /// Snapshot legible del evento: { description, amountCents, targetName, ... }
  meta         Json         @default("{}")
  createdAt    DateTime     @default(now())

  group      Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor      User        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  expense    Expense?    @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([createdAt])
}
