# Conexión a PostgreSQL
DATABASE_URL="postgresql://split:split@localhost:5432/split?schema=public"

# Secreto para firmar cookies de sesión. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambiame-por-un-secreto-largo-y-aleatorio"

# URL pública de la app (se usa para armar los links de invitación)
APP_URL="https://split.erginos.com.ar"

# Email del primer usuario administrador. Si la base está vacía,
# el registro en /registro crea esta cuenta sin necesitar invitación.
BOOTSTRAP_ADMIN_EMAIL="vos@ejemplo.com"
