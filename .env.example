# Copiá este archivo a .env y completá los valores.
#   cp .env.example .env

# ---------------------------------------------------------------- aplicación

# URL pública, con esquema y sin barra final. Se usa para armar los links de
# invitación y las vistas previas que se ven al compartirlos.
APP_URL=https://gastos.ejemplo.com

# Firma los tokens de sesión y los links de restablecer contraseña.
# Generalo con:  openssl rand -hex 32
# Si lo cambiás, se cierran todas las sesiones y se invalidan los links.
AUTH_SECRET=

# Con la base vacía, esta es la única cuenta que puede registrarse sin
# invitación, y queda como administradora. Después el registro es cerrado.
BOOTSTRAP_ADMIN_EMAIL=vos@ejemplo.com

# Zona horaria del servidor. Las fechas se formatean del lado del servidor,
# así que sin esto un gasto cargado de noche aparece con la fecha de mañana.
TZ=America/Argentina/Buenos_Aires

# Puerto del host donde publicar la app (sólo lo usa docker compose).
APP_PORT=3000

# ------------------------------------------------------------ base de datos

POSTGRES_USER=vaquita
POSTGRES_PASSWORD=
POSTGRES_DB=vaquita

# Sólo para desarrollo con `npm run dev`, que corre fuera de Docker.
# Dentro de docker compose esta variable se ignora: ahí la conexión se arma
# sola a partir de las POSTGRES_* y apunta al servicio `db`.
DATABASE_URL=postgresql://vaquita:vaquita@localhost:5433/vaquita?schema=public
